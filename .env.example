# Copy to .env and fill in.
# .env is gitignored. Never commit a Census API key.

# Free Census API key (request one at https://api.census.gov/data/key_signup.html).
# Required for: county FIPS lookup, ACS table B19001, tract household counts.
CENSUS_API_KEY=

# Optional: override the on-disk cache directory.
# Default: platformdirs.user_cache_dir("energy-equity")
# Examples:
#   EE_CACHE_DIR=/data/eoc/cache/energy-equity
#   EE_CACHE_DIR=~/scratch/ee-cache
# EE_CACHE_DIR=
